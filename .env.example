# Secret for signing paid-order receipts. Set a random value in production.
PAYMENT_SECRET=change-me

# Provider: "mock" (default) or your gateway adapter.
PAYMENT_PROVIDER=mock

# Mock only: auto-settle a pending order after N ms. 0 disables auto-settle.
PAYMENT_AUTO_SETTLE_MS=20000

# Data embedded in the generated QRIS payload.
QRIS_MERCHANT_ID=ID1234567890000
QRIS_MERCHANT_NAME=PHOTOBOOTH DEMO
QRIS_MERCHANT_CITY=JAKARTA
